# KaamSetu Frontend Environment Variables
# If backend is hosted on a separate domain (e.g. Railway, Render, EC2), specify the full API base URL:
# VITE_API_BASE_URL=https://kaamsetu-backend.up.railway.app/api
# If frontend & backend are hosted together or behind a reverse proxy (e.g. Nginx, Docker), leave as default:
VITE_API_BASE_URL=/api

